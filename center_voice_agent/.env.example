# === ЗАПОЛНИТЕ ПЕРВЫМ ДЕЛОМ (см. START_HERE.md) ===
# LLM (OpenAI-compatible endpoint для дообученной модели)
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace_me
# Или оставьте replace_me и задайте OPENAI_API_KEY (в т.ч. в ../voice_assistant/.env)
LLM_MODEL=your-finetuned-model

# Логи
LOG_LEVEL=INFO
LOG_JSON=true

# БД (SQLite по умолчанию для разработки)
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# Режим при первой записи сессии в БД
DEFAULT_MODE_ID=dialog

# Источник режимов: files | database | hybrid (файлы + поверх опубликованные из БД)
MODES_SOURCE=files
# Для строк в mode_definitions с привязкой к центру (иначе только center_id IS NULL)
# MODES_CENTER_ID=

# Источник сценариев: files | database | hybrid (таблица scenario_publish)
SCENARIOS_SOURCE=files
# SCENARIOS_CENTER_ID=

# Цикл LLM <-> tools через LangGraph (false — прежний императивный цикл в шлюзе)
USE_LANGGRAPH=true

# Plan B: парсить JSON-вызов tools из текста, если модель не поддерживает tool-calling
TEXT_TOOL_FALLBACK=true

# Лимиты (дублируются в config/agent.yaml — YAML удобнее методисту)
# SHORT_TERM_MAX_MESSAGES=15
# SHORT_TERM_SOURCE=memory   # memory | db — персист реплик в session_messages
# PREFETCH_MEMORY_LIMIT=8
# DEFAULT_MAX_TOOL_ROUNDS=10
# OPENAI_API_KEY=   # запасной ключ, если LLM_API_KEY пуст
# LLM_FALLBACK_ENV_FILE=../voice_assistant/.env

# Память: подмешивать последние факты в системный промпт до LLM
PREFETCH_LONG_TERM_MEMORY=true

# Логи: не писать сырой текст ребёнка (только длина и fingerprint)
LOG_REDACT_USER_TEXT=true

# Модерация (простой список фраз)
MODERATION_ENABLED=true

# Поиск в сети (POST JSON {"query": "..."} на ваш API)
# WEB_SEARCH_URL=https://search.example.com/api
WEB_SEARCH_TIMEOUT_SEC=15
TOOL_MAX_OUTPUT_CHARS=4000

# Опционально: LangSmith
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=center_voice_agent
